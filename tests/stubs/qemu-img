#!/bin/bash
printf 'qemu-img %s\n' "$*" >> "$STUB_LOG"
# the commands that write an image with a relative backing file also say where they ran
case "$1" in create|convert|rebase) printf 'cwd %s\n' "$PWD" >> "$STUB_LOG";; esac
# STUB_QEMU_IMG_INFO_FAIL: info fails, printing this as qemu-img's error
if [ "$1" = info ] && [ -n "${STUB_QEMU_IMG_INFO_FAIL:-}" ]; then echo "$STUB_QEMU_IMG_INFO_FAIL" >&2; exit 1; fi
case "$1" in create|convert) touch "${!#}";; esac
exit 0
